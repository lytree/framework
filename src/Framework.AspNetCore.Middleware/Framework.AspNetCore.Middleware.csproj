<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Version>1.0.0</Version>
		<PackageId>YLFramework.AspNetCore.Middleware</PackageId>
		<SignAssembly>False</SignAssembly>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" />
		<PackageReference Include="Yarp.ReverseProxy" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Framework.AspNetCore\Framework.AspNetCore.csproj" />
	</ItemGroup>

	<!-- 共享源码：直接引入 src/Shared 中需要的文件编译，不再引用独立 Framework 程序集 -->
	<ItemGroup>
		<Compile Include="..\Shared\System.Buffers\*.cs" Link="Shared\System.Buffers\%(Filename)%(Extension)" />
		<Compile Include="..\Shared\System.IO\*.cs" Link="Shared\System.IO\%(Filename)%(Extension)" />
		<Compile Include="..\Shared\System.IO.Pipelines\*.cs" Link="Shared\System.IO.Pipelines\%(Filename)%(Extension)" />
		<Compile Include="..\Shared\System.Threading\*.cs" Link="Shared\System.Threading\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="README.md">
			<PackagePath>\</PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
		</Resource>
	</ItemGroup>
</Project>

// YLFramework.Logging 配置模板
// 用法：把下面的 "Serilog" 节合并进 appsettings.json，
// 然后 builder.Logging.AddFrameworkSerilog(builder.Configuration)。
//
// 注意：只要存在 Serilog 节，输出目标就完全以此处为准，
// 代码里 FrameworkSerilogOptions 的 Console*/File*/Async* 属性不再生效，
// 只有 Application / ApplicationVersion / EnvironmentName 这类公共字段继续生效。
{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    },

    // 业务自定义字段：会被写进每一条日志，适合放应用名这类全局常量。
    "Properties": {
      "Application": "MyApp"
    },

    "Enrich": [ "FromLogContext" ],

    "WriteTo": [
      {
        // 异步包装：业务线程只入队，磁盘与终端 IO 交给后台线程。
        "Name": "Async",
        "Args": {
          "bufferSize": 10000,
          "blockWhenFull": false,
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Application} [{TraceId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              // 人读文件：纯文本，带完整时间戳与追踪标识。
              "Name": "File",
              "Args": {
                "path": "logs/app-.log",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 52428800,
                "retainedFileCountLimit": 31,
                "buffered": true,
                "flushToDiskInterval": "00:00:01",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Application} [{TraceId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
              }
            },
            {
              // 机器读文件：CLEF，一行一条 JSON，Seq / Loki / Elasticsearch 可直接按字段查询。
              // 与上面的纯文本文件二选一即可，同时开启只会重复占用磁盘。
              "Name": "File",
              "Args": {
                "path": "logs/app-.clef",
                "rollingInterval": "Day",
                "rollOnFileSizeLimit": true,
                "fileSizeLimitBytes": 52428800,
                "retainedFileCountLimit": 31,
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      }
    ]
  }
}

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Version>2.0.0-alpha.1</Version>
		<PackageId>YLFramework.Repository</PackageId>
		<SignAssembly>False</SignAssembly>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BouncyCastle.Cryptography" />
		<PackageReference Include="linq2db" />
		<PackageReference Include="Mapster" />
		<PackageReference Include="System.Text.Json" />
		<PackageReference Include="Yitter.IdGenerator" />
	</ItemGroup>

	<!-- 共享源码：直接引入 src/Shared 中需要的文件编译，不再引用独立 Framework 程序集 -->
	<ItemGroup>
		<Compile Include="..\Shared\Helpers\Helper.Entity.cs" Link="Shared\Helpers\Helper.Entity.cs" />
		<Compile Include="..\Shared\Helpers\Helper.Interface.cs" Link="Shared\Helpers\Helper.Interface.cs" />
		<Compile Include="..\Shared\Helpers\Helper.Json.cs" Link="Shared\Helpers\Helper.Json.cs" />
		<Compile Include="..\Shared\Helpers\Helper.Encoding.cs" Link="Shared\Helpers\Helper.Encoding.cs" />
		<Compile Include="..\Shared\Helpers\Helper.DateTime.cs" Link="Shared\Helpers\Helper.DateTime.cs" />
		<Compile Include="..\Shared\System\*.cs" Link="Shared\System\%(Filename)%(Extension)" />
		<Compile Include="..\Shared\System.Reflection\*.cs" Link="Shared\System.Reflection\%(Filename)%(Extension)" />
		<Compile Include="..\Shared\System.Collections.Generic\*.cs" Link="Shared\System.Collections.Generic\%(Filename)%(Extension)" />
		<Compile Include="..\Shared\System.Convert\*.cs" Link="Shared\System.Convert\%(Filename)%(Extension)" />
		<Compile Include="..\Shared\System.Text.Json.Serialization\*.cs" Link="Shared\System.Text.Json.Serialization\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="README.md">
			<PackagePath>\</PackagePath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Pack>True</Pack>
		</Resource>
	</ItemGroup>
</Project>